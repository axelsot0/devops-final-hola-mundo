# ─────────────────────────────────────────────────────────────
# Base de datos PostgreSQL
# ─────────────────────────────────────────────────────────────

# Opción A · Docker (docker compose up -d): funciona tal cual.
DATABASE_URL="postgresql://planea:planea@localhost:5432/planea_dev"

# Opción B · Supabase
# En el panel del proyecto pulsa «Connect» (arriba) y copia una cadena.
# Supabase ofrece varias; usa la de **Session pooler**, que llega por el
# puerto 5432 y su host contiene «pooler.supabase.com». Reemplaza
# [YOUR-PASSWORD] por la contraseña de la base:
#
# DATABASE_URL="postgresql://postgres.abcdefgh:TU-CLAVE@aws-0-us-east-1.pooler.supabase.com:5432/postgres"
#
# NO uses la cadena del «Transaction pooler» (puerto 6543) para preparar la
# base: usa sentencias preparadas de forma incompatible con `prisma db push`
# y el comando falla. Si aun así la necesitas para producción, añádele
# `?pgbouncer=true&connection_limit=1`.
#
# La «Direct connection» (host db.xxxx.supabase.co) también sirve, pero en
# proyectos nuevos solo responde por IPv6 y muchas redes domésticas no la
# alcanzan; por eso el Session pooler es la opción segura.

# ─────────────────────────────────────────────────────────────
# Autenticación
# ─────────────────────────────────────────────────────────────

# Secreto para firmar las sesiones de Auth.js.
# Genera uno nuevo con: npx auth secret   (o: openssl rand -base64 32)
AUTH_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"

# Necesario en desarrollo local y en despliegues detrás de un proxy.
AUTH_TRUST_HOST=true
